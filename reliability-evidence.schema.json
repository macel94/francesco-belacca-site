{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/macel94/francesco-belacca-site/main/reliability-evidence.schema.json",
  "title": "Belacca sanitized reliability evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "sanitized", "generated_at", "source_repository", "entries"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "const": "belacca.reliability-evidence.v1" },
    "sanitized": { "const": true },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_repository": { "type": "string", "format": "uri", "maxLength": 500 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "state", "summary", "observed_at", "source_updated_at", "source_references", "limitations"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "state": { "enum": ["verified", "bounded", "outstanding", "declared"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "observed_at": { "type": ["string", "null"], "format": "date-time" },
          "source_updated_at": { "type": ["string", "null"], "format": "date-time" },
          "source_references": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "format": "uri", "maxLength": 500 } },
          "limitations": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } }
        }
      }
    }
  }
}
