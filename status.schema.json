{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francesco.belacca.com/status.schema.json",
  "title": "Belacca public status contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sanitized",
    "publication_state",
    "status",
    "summary",
    "updated_at",
    "evidence_timestamp",
    "valid_until",
    "publisher",
    "human_review",
    "uptime",
    "components",
    "incidents",
    "source_references",
    "notes"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "const": "belacca.public-status.v1" },
    "sanitized": { "const": true },
    "publication_state": { "enum": ["not_configured", "published"] },
    "status": { "enum": ["unknown", "operational", "degraded", "incident"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_reference"],
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 120 },
        "source_reference": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": { "enum": ["not_configured", "approved"] },
        "approved_by": { "type": ["string", "null"], "maxLength": 120 },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "uptime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "window", "source_reference"],
      "properties": {
        "state": { "enum": ["not_configured", "reported"] },
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "window": { "type": ["string", "null"], "maxLength": 120 },
        "source_reference": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "components": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "summary", "evidence_timestamp", "source_references"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "enum": ["unknown", "operational", "degraded", "incident"] },
          "summary": { "type": "string", "maxLength": 240 },
          "evidence_timestamp": { "type": ["string", "null"], "format": "date-time" },
          "source_references": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 500 } }
        }
      }
    },
    "incidents": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary", "started_at", "updated_at", "source_references"],
        "properties": {
          "id": { "type": "string", "maxLength": 100 },
          "status": { "enum": ["investigating", "identified", "monitoring", "resolved"] },
          "summary": { "type": "string", "maxLength": 240 },
          "started_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "source_references": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 500 } }
        }
      }
    },
    "source_references": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
    "notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
  }
}
